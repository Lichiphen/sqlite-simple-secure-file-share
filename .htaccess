# Simple Secure File Share - URL Rewriting
# Apache 2.4+

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # =========================================================================
    # サブディレクトリに配置する場合は以下を変更してください
    # 例: /simple-secure-file-share/ に配置する場合
    #     RewriteBase /simple-secure-file-share/
    # ルートに配置する場合はそのまま / でOK
    # =========================================================================
    RewriteBase /

    # =========================================================================
    # HTTPS Redirect (Uncomment for production) HTTPSを強制。ローカルでは
    # 以下2行をコメントアウト推奨
    # =========================================================================
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 内部ディレクトリ・設定ファイル・ドットファイルへの直接アクセスを拒否
    RewriteRule ^(src|templates|lang|storage|database)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(config|version)\.php$ - [F,L]

    # Existing files and directories are served directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "(\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|db|log|bak|sql|ini|php~|swp)|^\.app_secret|^sess_.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers (動的ページは PHP 側で CSP 等を付与)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always unset X-Powered-By
</IfModule>
